<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>net.fourletters</groupId>
    <artifactId>fourletters-parent</artifactId>
    <version>0.0.0</version> 
    <packaging>pom</packaging>

    <name>fourletters-parent</name>
    <description>Parent for fourletters messenger modules</description>

    <modules>
        <module>common</module>
        <module>server</module>
        <!--<module>hub</module>-->
    </modules>

    <properties>
        <java.version>17</java.version>        
        <firebase-admin.version>9.9.0</firebase-admin.version>
        <jjwt.version>0.13.0</jjwt.version>
        <jspecify.version>1.0.0</jspecify.version>
        <vk-sdk.version>1.0.16</vk-sdk.version>
        <google-api-client.version>2.9.0</google-api-client.version>
    </properties>

    <dependencyManagement>
        <dependencies>            
            <dependency>
                <groupId>net.fourletters</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            
            <dependency>
                <groupId>com.google.firebase</groupId>
                <artifactId>firebase-admin</artifactId>
                <version>${firebase-admin.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vk.api</groupId>
                <artifactId>sdk</artifactId>
                <version>${vk-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.api-client</groupId>
                <artifactId>google-api-client</artifactId>
                <version>${google-api-client.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>